{
  "expo": {
    "name": "hydrogen",
    "slug": "hydrogen",
    "version": "1.0.2",
    "runtimeVersion": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d2d2d"
    },
    "splashScreen": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d2d2d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rotech.bleconnection",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para capturar imágenes",
        "NSMicrophoneUsageDescription": "Para grabar audio junto con el video de medición",
        "NSPhotoLibraryAddUsageDescription": "Para guardar fotos y videos en tu galería"
      }
    },
    "android": {
      "backgroundColor": "#2d2d2d",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-icon.png",
        "backgroundColor": "#F44336"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rotech.ble_connection"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-icon.png"
    },
    "plugins": [
      [
        "@config-plugins/ffmpeg-kit-react-native",
        {
          "package": "full-gpl"
        }
      ],
      "./plugins/withAppodealFFmpegMaven",
      [
        "expo-router"
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acceso a la cámara para capturar imágenes",
          "microphonePermission": "Permitir el micrófono para grabar audio en los vídeos de medición"
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Permitir guardar fotos y videos en tu galería para que puedas acceder a ellos desde la app Fotos"
        }
      ],
      "./plugins/withAndroidLint",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/e818c8ef-21ee-43f8-a96f-927d802adab0"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e818c8ef-21ee-43f8-a96f-927d802adab0"
      }
    }
  }
}
